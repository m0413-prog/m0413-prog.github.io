  function heroStorageKey(name) {
    return 'hero:' + name.trim();
  }

  const hasClaudeStorage = typeof window.storage !== 'undefined';

  async function storageGet(key) {
    if (hasClaudeStorage) {
      try {
        const result = await window.storage.get(key, false);
        return result ? result.value : null;
      } catch (e) { return null; }
    }
    try { return localStorage.getItem(key); } catch (e) { return null; }
  }

  async function storageSet(key, value) {
    if (hasClaudeStorage) {
      try { await window.storage.set(key, value, false); } catch (e) {}
      return;
    }
    try { localStorage.setItem(key, value); } catch (e) {}
  }

  async function storageDelete(key) {
    if (hasClaudeStorage) {
      try { await window.storage.delete(key, false); } catch (e) {}
      return;
    }
    try { localStorage.removeItem(key); } catch (e) {}
  }

  async function loadHero() {
    const nameInput = document.getElementById('heroName');
    const name = nameInput.value.trim() || 'ヒーロー';
    const key = heroStorageKey(name);
    document.getElementById('loadingNote').style.display = 'block';
    document.getElementById('powerUpBtn').disabled = true;

    try {
      const value = await storageGet(key);
      if (value) {
        const parsed = JSON.parse(value);
        state = {
          power: parsed.power || 0,
          history: parsed.history || [],
          parentLock: parsed.parentLock !== undefined ? parsed.parentLock : false,
          categoryCounts: parsed.categoryCounts || {},
          lastPlayDate: parsed.lastPlayDate || getTodayStr(),
          lastSkill: parsed.lastSkill || "",
          lastMsg: parsed.lastMsg || ""
        };
      } else {
        state = { power: 0, history: [], parentLock: false, categoryCounts: {}, lastPlayDate: getTodayStr(), lastSkill: "", lastMsg: "" };
      }
    } catch (e) {
      state = { power: 0, history: [], parentLock: false, categoryCounts: {}, lastPlayDate: getTodayStr(), lastSkill: "", lastMsg: "" };
    }

    currentHeroKey = key;
    currentLevel = levelFromPower(state.power);
    document.getElementById('todayPower').textContent = state.power;
    document.getElementById('yesterdayPower').textContent = state.power;
    updateTitle(currentLevel);
    updateXpUI();
    walkX = WALK_MIN_X;
    updateTargetX();
    startAnimationLoop();
    renderHistory();
    updateParentLockUI();
    document.getElementById('loadingNote').style.display = 'none';
  }

  async function saveHero() {
    if (!currentHeroKey) return;
    await storageSet(currentHeroKey, JSON.stringify(state));
  }

  async function resetHero() {
    if (!currentHeroKey) return;
    if (!confirm('このヒーローの記録をすべて消しますか？')) return;
    await storageDelete(currentHeroKey);
    await loadHero();
  }

