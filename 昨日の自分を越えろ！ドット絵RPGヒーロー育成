        drawHouse(hx2, horizon - 22, 22, 22, wall, roof);
        hx2 += 80;
      }
    } else {
      const g = ctx.createLinearGradient(0, 0, 0, horizon);
      g.addColorStop(0, "#2b1055"); g.addColorStop(1, "#6a2e6f");
      ctx.fillStyle = g; ctx.fillRect(0, 0, w, horizon);
      ctx.fillStyle = "#7a1f2b";
      ctx.fillRect(0, horizon, w, h - horizon);
      ctx.fillStyle = "#d4af37";
      ctx.fillRect(0, horizon, w, 4);
      drawCastleTower(16, horizon - 50, 26, 50, "#8a8a9a");
      drawCastleTower(246, horizon - 50, 26, 50, "#8a8a9a");
      ctx.fillStyle = "#5c5c6e";
      ctx.fillRect(66, horizon - 34, 156, 34);
      ctx.fillStyle = "#3a3a48";
      ctx.fillRect(130, horizon - 20, 28, 20);
    }
  }

  function drawGoalMarker() {
    const gx = WALK_MAX_X + 16 * SPRITE_P + 4;
    ctx.fillStyle = "#5a3a22";
    ctx.fillRect(gx, horizon - 38, 4, 38);
    ctx.fillStyle = "#ffcc00";
    ctx.beginPath();
    ctx.moveTo(gx + 4, horizon - 38);
    ctx.lineTo(gx + 18, horizon - 32);
    ctx.lineTo(gx + 4, horizon - 26);
    ctx.closePath();
    ctx.fill();
