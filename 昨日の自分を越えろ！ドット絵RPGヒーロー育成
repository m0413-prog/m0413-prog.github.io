    const catRubyNames = {
      "宿題・勉強": "「【<ruby>学習<rt>がくしゅう</rt></ruby>】<ruby>宿題<rt>しゅくだい</rt></ruby>・<ruby>勉強<rt>べんきょう</rt></ruby>・<ruby>習<rt>なら</rt></ruby>い<ruby>事<rt>ごと</rt></ruby>」",
      "お手伝い": "「【<ruby>貢献<rt>こうけん</rt></ruby>】お<ruby>手伝<rt>てつだ</rt></ruby>い・<ruby>掃除<rt>そうじ</rt></ruby>」",
      "運動・健康": "「【<ruby>体力<rt>たいりょく</rt></ruby>】<ruby>運動<rt>うんどう</rt></ruby>・スポーツ・<ruby>早<rt>はや</rt></ruby><ruby>起<rt>お</rt></ruby>き」",
      "読書": "「【<ruby>知識<rt>ちしき</rt></ruby>】<ruby>読書<rt>どくしょ</rt></ruby>」",
      "休養・自由時間": "「【<ruby>休養<rt>きゅうよう</rt></ruby>】ゲーム・<ruby>漫画<rt>まんが</rt></ruby>・<ruby>昼寝<rt>ひるね</rt></ruby>」"
    };

    const msgBox = document.getElementById('msgBox');
    const msgTitle = document.getElementById('msgTitle');

    if (state.parentLock) {
      const currentCount = state.categoryCounts[category] || 0;
      if (currentCount >= 2) {
        // 回数制限時のおしらせ：枠線・タイトル文字ともに赤色強調
        msgBox.style.borderColor = "#ff4d4d";
        msgTitle.style.color = "#ff4d4d";
        msgTitle.innerHTML = "⚠️ <ruby>回数<rt>かいすう</rt></ruby><ruby>制限<rt>せいげん</rt></ruby>のおしらせ";
        document.getElementById('skillName').innerHTML = "";
        document.getElementById('msgContent').innerHTML = `${catRubyNames[category] || category}は<ruby>本日<rt>ほんじつ</rt></ruby>すでに2<ruby>回<rt>かい</rt></ruby>おこないました。<ruby>他<rt>ほか</rt></ruby>のカテゴリーを<ruby>選<rt>えら</rt></ruby>ぶか、<ruby>明日<rt>あした</rt></ruby>また<ruby>挑戦<rt>ちょうせん</rt></ruby>してね！`;
        msgBox.style.display = 'block';
        return;
      }
    }

    // 通常判定時：スタイルを初期値（白枠・黄文字）に戻す
    msgBox.style.borderColor = "#ffffff";
    msgTitle.style.color = "#ffcc00";

    const btn = document.getElementById('powerUpBtn');
    btn.disabled = true;

    const timeMinutes = parseInt(document.getElementById('actionTime').value) || 5;
    const detail = document.getElementById('actionDetail').value.trim();
    const name = document.getElementById('heroName').value || "ヒーロー";

    const text = detail.toLowerCase();
    const lowKeywords = ["漫画", "マンガ", "まんが", "コミック", "昼寝", "ひるね", "寝た", "ねた", "ごろごろ", "ゴロゴロ", "ゲーム", "テレビ", "さぼ", "サボ", "何もしない", "スマホ", "youtube"];
    const isLowText = lowKeywords.some(kw => text.includes(kw));

    let bonus = 0;
    let skill = "";
    let title = "";
    let msg = "";

    const yesterdayPwr = state.power;
    const isRest = (category === "休養・自由時間" || isLowText);

    const skillsMap = {
      "宿題・勉強": [
        "<ruby>集中<rt>しゅうちゅう</rt></ruby>ドリル<ruby>斬<rt>ぎ</rt></ruby>り",
        "ブレイン・スマッシュ",
        "<ruby>閃光<rt>せんこう</rt></ruby>スタディ・バースト",
        "<ruby>知恵<rt>ちえ</rt></ruby>のメテオストライク"
      ],
      "お手伝い": [
        "ピカピカクリーンブレイク",
        "おたすけハリケーン",
        "サンキュー・エクスプロージョン",
        "<ruby>奉仕<rt>ほうし</rt></ruby>のホーリーレイ"
      ],
      "運動・健康": [
        "<ruby>爆速<rt>ばくそく</rt></ruby>ダッシュストライク",
        "マッスル・ボルケーノ",
        "<ruby>健康<rt>けんこう</rt></ruby>パワースマッシュ",
        "エナジー・トルネード"
      ],
      "読書": [
        "ナレッジウェーブ",
        "イマジネーション・ダイブ",
        "ブック・オブ・ジャッジメント",
        "<ruby>知能<rt>ちのう</rt></ruby>フレア"
      ],
      "休養・自由時間": [
        "すやすやパワー<ruby>充電<rt>じゅうでん</rt></ruby>",
        "リラックス・ヒール",
        "のんびりサンクチュアリ",
        "まったりオーラ・リカバリー"
      ]
    };

    let skillPool = isRest ? skillsMap["休養・自由時間"] : (skillsMap[category] || ["ミライヒーロー<ruby>斬<rt>ぎ</rt></ruby>り", "<ruby>勇気<rt>ゆうき</rt></ruby>の<ruby>一撃<rt>いちげき</rt></ruby>"]);
    let availableSkills = skillPool.filter(s => s !== state.lastSkill);
    if (availableSkills.length === 0) availableSkills = skillPool;
    skill = availableSkills[Math.floor(Math.random() * availableSkills.length)];
    state.lastSkill = skill;

    if (isRest) {
      bonus = 2;
      title = "💤 <ruby>体力<rt>たいりょく</rt></ruby>を<ruby>回復<rt>かいふく</rt></ruby>した！ (+2 PT)";
      msg = getRandomMessage(true, name, category, detail, timeMinutes);
      play8BitSound(false);
    } else {
      bonus = Math.floor(timeMinutes * 0.45) + 3;
      title = `🔥 <ruby>昨日<rt>きのう</rt></ruby>の<ruby>自分<rt>じぶん</rt></ruby>を<ruby>越<rt>こ</rt></ruby>えた！ (+${bonus} PT)`;
      msg = getRandomMessage(false, name, category, detail, timeMinutes);
      play8BitSound(true);
    }

    state.categoryCounts[category] = (state.categoryCounts[category] || 0) + 1;

    const newPower = yesterdayPwr + bonus;
    state.power = newPower;

    const catLabels = {
      "宿題・勉強": "<ruby>宿題<rt>しゅくだい</rt></ruby>・<ruby>勉強<rt>べんきょう</rt></ruby>",
      "お手伝い": "お<ruby>手伝<rt>てつだ</rt></ruby>い",
      "運動・健康": "<ruby>運動<rt>うんどう</rt></ruby>・<ruby>健康<rt>けんこう</rt></ruby>",
      "読書": "<ruby>読書<rt>どくしょ</rt></ruby>",
      "休養・自由時間": "<ruby>休養<rt>きゅうよう</rt></ruby>・<ruby>自由時間<rt>じゆうじかん</rt></ruby>"
    };

    state.history.unshift({
      label: `${catLabels[category] || category}${detail ? '（' + detail + '）' : ''} / ${timeMinutes}<ruby>分<rt>ふん</rt></ruby>`,
      bonus: bonus
    });
    state.history = state.history.slice(0, 30);

    document.getElementById('todayPower').textContent = newPower;
    document.getElementById('yesterdayPower').textContent = newPower;
    msgTitle.innerHTML = title;

    document.getElementById('skillName').innerHTML = `⚔️ ひっさつわざ：「${skill}」`;
    document.getElementById('msgContent').innerHTML = msg;
    msgBox.style.display = 'block';
    renderHistory();

    const stage = document.getElementById('stage');
    const newLevel = levelFromPower(newPower);
    const leveledUp = newLevel > currentLevel;

    stage.classList.add(leveledUp ? 'leveling-up' : 'powering-up');
    triggerBounce(leveledUp ? 1600 : 900);
    if (leveledUp) {
      const banner = document.getElementById('levelupBanner');
      banner.innerHTML = `★ ${SCENE_NAMES[newLevel - 1]}に<ruby>到着<rt>とうちゃく</rt></ruby>！レベルアップ！ ★`;
      banner.style.display = 'block';
      banner.style.animation = 'none';
      void banner.offsetWidth;
      banner.style.animation = '';
      walkX = WALK_MIN_X;
    }

    currentLevel = newLevel;
    updateTitle(currentLevel);
    updateXpUI();
    updateTargetX();

    setTimeout(() => {
      stage.classList.remove('powering-up');
      stage.classList.remove('leveling-up');
    }, leveledUp ? 1600 : 1200);

    await saveHero();
    updateParentLockUI();
  }

  document.getElementById('heroName').addEventListener('change', loadHero);

  loadHero();
</script>

</body>
</html>
