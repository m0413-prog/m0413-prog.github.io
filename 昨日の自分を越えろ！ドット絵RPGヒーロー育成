  // ── レベル閾値 ─────────────
  const LEVEL_THRESHOLDS = [0, 40, 100, 190, 320, 500, 730, 1020];

  function levelFromPower(p) {
    let lvl = 1;
    for (let i = 1; i < LEVEL_THRESHOLDS.length; i++) {
      if (p >= LEVEL_THRESHOLDS[i]) lvl = i + 1;
    }
    return lvl;
  }

  // ── スプライト描画 ─────────────────
  function getPalette(level) {
    // LV.8のスーツ色を赤マントと同化しないロイヤルブルー (#2563eb) に変更
    const suitByLevel = ["#33cc33", "#2ea86e", "#00cc99", "#00a8c0", "#0066ff", "#5b3df5", "#aa00ff", "#2563eb"];
    const armorByLevel = ["#999999", "#aaaaaa", "#bfbfbf", "#c9b37f", "#d4af37", "#e0c040", "#ffd700", "#ffd700"];
    const capeByLevel = [null, null, null, null, null, "#aa00ff", "#c724a8", "#ff0055"];
    return { suit: suitByLevel[level - 1], armor: armorByLevel[level - 1], cape: capeByLevel[level - 1] };
  }

  const BASE_SPRITE = [
    "................", ".....HHHHHH.....", "....HHHHHHHH....", "....SSSSSSSS....",
    "....SSESSSES....", "....SSSSSSSS....", ".....SMMMM......", "....AAASSAAA....",
    "...AAAASSSAAA...", "...A.LLLLLL.A...", ".....LLLLLL.....", ".....LLLLLL....."
  ];
  const LEG_FRAMES = [
    [".....LL..LL.....", ".....LL..LL.....", "....BBB..BBB...."],
    ["....LL....LL....", "....LL....LL....", "...BBB....BBB..."]
  ];

  function drawSprite(level, ox, oy, p, legFrame, mirrored) {
    const pal = getPalette(level);
    const c = {
      skin: "#ffcc99", hair: "#663300", eye: "#000000",
      suit: pal.suit, armor: pal.armor, cape: pal.cape,
      boots: "#4a2c17", sword: "#ffffff", gold: "#ffcc00"
    };
    const sprite = BASE_SPRITE.concat(LEG_FRAMES[legFrame % 2], ["................"]);

    ctx.save();
    ctx.translate(ox, oy);
    if (mirrored) {
      ctx.translate(16 * p, 0);
      ctx.scale(-1, 1);
    }

    if (level >= 8) {
      ctx.save();
      ctx.globalAlpha = 0.55;
      ctx.fillStyle = c.gold;
      ctx.beginPath();
      ctx.arc(8 * p, 8 * p, 9 * p, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    if (c.cape) {
      ctx.fillStyle = c.cape;
      ctx.beginPath();
      ctx.moveTo(3 * p, 6 * p);
      ctx.lineTo(13 * p, 6 * p);
      ctx.lineTo(15 * p, 14.5 * p);
      ctx.lineTo(1 * p, 14.5 * p);
      ctx.closePath();
      ctx.fill();
    }

    for (let r = 0; r < 16; r++) {
      for (let col = 0; col < 16; col++) {
        const char = sprite[r][col];
        if (char === ".") continue;
        if (char === "H") ctx.fillStyle = c.hair;
        if (char === "S") ctx.fillStyle = c.skin;
        if (char === "E") ctx.fillStyle = c.eye;
        if (char === "M") ctx.fillStyle = "#ff6666";
        if (char === "A") ctx.fillStyle = c.armor;
        if (char === "L") ctx.fillStyle = c.suit;
        if (char === "B") ctx.fillStyle = c.boots;
        ctx.fillRect(col * p, r * p, p, p);
      }
    }

    if (level >= 2) {
      ctx.fillStyle = c.sword;
      ctx.fillRect(12 * p, 4 * p, 2 * p, 8 * p);
      ctx.fillStyle = c.gold;
      ctx.fillRect(11 * p, 8 * p, 4 * p, 2 * p);
    }

    if (level >= 8) {
      ctx.fillStyle = c.gold;
      ctx.fillRect(5 * p, 0, p, p * 0.6);
      ctx.fillRect(7 * p, 0, p, p * 0.6);
      ctx.fillRect(9 * p, 0, p, p * 0.6);
    }

    ctx.restore();
  }

  // ── アニメーション ──
  const SPRITE_P = 5;
  const WALK_MIN_X = 20;
  const WALK_MAX_X = canvas.width - 24 - 16 * SPRITE_P;
  const WALK_SPEED = 55;
  let walkX = WALK_MIN_X;
  let targetX = WALK_MIN_X;
  let legFrame = 0;
  let legToggleAccum = 0;
  let lastFrameTs = 0;
  let bounceStart = null;
  let bounceDuration = 0;
  let loopStarted = false;

  function triggerBounce(duration) {
    bounceStart = performance.now();
    bounceDuration = duration;
  }

  function progressRatio() {
    const lvl = currentLevel;
    if (lvl >= 8) return 1;
    const lower = LEVEL_THRESHOLDS[lvl - 1];
    const upper = LEVEL_THRESHOLDS[lvl];
    return Math.max(0, Math.min(1, (state.power - lower) / (upper - lower)));
  }

  function updateTargetX() {
    targetX = WALK_MIN_X + progressRatio() * (WALK_MAX_X - WALK_MIN_X);
  }

  function updateXpUI() {
    const fill = document.getElementById('xpBarFill');
    const label = document.getElementById('xpLabel');
    if (currentLevel >= 8) {
      fill.style.width = '100%';
      label.innerHTML = 'でんせつのヒーローに<ruby>到達<rt>とうたつ</rt></ruby>！';
    } else {
      const upper = LEVEL_THRESHOLDS[currentLevel];
      fill.innerHTML = `つぎのレベルまで あと ${Math.max(0, upper - state.power)} pt`;
      label.innerHTML = `つぎのレベルまで あと ${Math.max(0, upper - state.power)} pt`;
    }
  }

  function renderLoop(ts) {
    if (!lastFrameTs) lastFrameTs = ts;
    const dt = ts - lastFrameTs;
    lastFrameTs = ts;

    if (Math.abs(targetX - walkX) > 0.5) {
      const step = WALK_SPEED * (dt / 1000);
      walkX = (targetX > walkX) ? Math.min(targetX, walkX + step) : Math.max(targetX, walkX - step);
      legToggleAccum += dt;
      if (legToggleAccum > 140) { legFrame = legFrame === 0 ? 1 : 0; legToggleAccum = 0; }
    } else {
      walkX = targetX;
      legFrame = 0;
    }

    let bounceOffset = 0;
    if (bounceStart !== null) {
      const elapsed = ts - bounceStart;
      if (elapsed < bounceDuration) {
        bounceOffset = -Math.abs(Math.sin((elapsed / bounceDuration) * Math.PI)) * 14;
      } else {
        bounceStart = null;
      }
    }

    drawBackground(currentLevel);
    drawGoalMarker();
    const spriteY = horizon - 16 * SPRITE_P + bounceOffset;
    drawSprite(currentLevel, walkX, spriteY, SPRITE_P, legFrame, false);

    requestAnimationFrame(renderLoop);
  }

  function startAnimationLoop() {
    if (loopStarted) return;
    loopStarted = true;
    requestAnimationFrame(renderLoop);
  }

