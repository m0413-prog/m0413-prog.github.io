<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>昨日の自分を越えろ！ドット絵RPGヒーロー育成</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DotGothic16&display=swap');

    * {
      box-sizing: border-box;
      font-family: 'DotGothic16', monospace;
      image-rendering: pixelated;
    }

    body {
      background-color: #050510;
      background-image:
        radial-gradient(#1e1e38 15%, transparent 16%),
        radial-gradient(#1e1e38 15%, transparent 16%);
      background-size: 20px 20px;
      background-position: 0 0, 10px 10px;
      color: #ffffff;
      margin: 0;
      padding: 16px 8px;
      display: flex;
      justify-content: center;
      min-height: 100vh;
    }

    /* ルビ（ふりがな）のスタイリング */
    ruby {
      ruby-align: center;
    }
    rt {
      font-size: 0.65em;
      color: #ffcc00;
      font-weight: normal;
      line-height: 1.2;
    }

    .rpg-window {
      max-width: 460px;
      width: 100%;
      background: #000044;
      border: 4px solid #ffffff;
      outline: 4px solid #000000;
      box-shadow: inset 0 0 0 4px #0000aa, 0 10px 30px rgba(0,0,0,0.8);
      border-radius: 4px;
      padding: 16px;
    }

    .title-banner {
      text-align: center;
      background: #e60000;
      border: 2px solid #fff;
      color: #ffff00;
      font-size: 20px;
      padding: 6px;
      margin-bottom: 4px;
      text-shadow: 2px 2px #000;
      letter-spacing: 2px;
    }

    .subtitle {
      text-align: center;
      font-size: 13px;
      color: #aaaaff;
      margin-bottom: 12px;
    }

    /* 最上部に配置した保護者設定バー */
    .parent-bar {
      background: #000022;
      border: 1px dashed #8888ff;
      padding: 6px 10px;
      font-size: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      border-radius: 4px;
    }

    .parent-btn {
      background: #444477;
      border: 1px solid #aaaaff;
      color: #fff;
      font-size: 11px;
      padding: 3px 8px;
      cursor: pointer;
      border-radius: 3px;
    }

    .stage {
      background: #000022;
      border: 3px solid #5555ff;
      border-radius: 4px;
      padding: 16px;
      text-align: center;
      margin-bottom: 16px;
      position: relative;
    }

    .level-badge {
      display: inline-block;
      background: #ffcc00;
      color: #000;
      font-size: 14px;
      padding: 2px 8px;
      border: 2px solid #fff;
      margin-bottom: 8px;
      font-weight: bold;
    }

    .level-badge rt {
      color: #000000;
      font-weight: bold;
    }

    #characterCanvas {
      background: transparent;
      display: block;
      margin: 0 auto;
      filter: drop-shadow(0 0 8px rgba(0,255,255,0.4));
    }

    .powering-up #characterCanvas {
      animation: auraGlow 0.3s infinite alternate;
    }

    .leveling-up #characterCanvas {
      animation: auraGlow 0.25s infinite alternate;
    }

    @keyframes auraGlow {
      0% { filter: drop-shadow(0 0 6px #00ffff) drop-shadow(0 0 12px #ffff00); }
      100% { filter: drop-shadow(0 0 16px #ff00ff) drop-shadow(0 0 24px #ffffff); }
    }

    .levelup-banner {
      display: none;
      position: absolute;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      background: #ffcc00;
      color: #000;
      font-size: 13px;
      padding: 4px 10px;
      border: 2px solid #fff;
      white-space: nowrap;
      animation: floatUp 1.8s ease-out forwards;
    }

    @keyframes floatUp {
      0% { opacity: 0; transform: translate(-50%, 10px); }
      15% { opacity: 1; transform: translate(-50%, 0); }
      80% { opacity: 1; }
      100% { opacity: 0; transform: translate(-50%, -14px); }
    }

    .status-container {
      display: flex;
      justify-content: space-around;
      background: #000;
      border: 2px solid #fff;
      padding: 8px;
      margin-top: 8px;
    }

    .xp-bar-wrap {
      background: #000;
      border: 2px solid #fff;
      height: 12px;
      margin-top: 8px;
      overflow: hidden;
    }

    .xp-bar-fill {
      background: linear-gradient(90deg, #ffcc00, #ff8800);
      height: 100%;
      width: 0%;
      transition: width 0.5s ease-out;
    }

    .xp-label {
      text-align: center;
      font-size: 11px;
      color: #aaaaff;
      margin-top: 4px;
    }

    .status-item {
      text-align: center;
    }

    .status-title {
      font-size: 12px;
      color: #8888ff;
    }

    .status-num {
      font-size: 22px;
      color: #00ffcc;
      text-shadow: 2px 2px #000;
    }

    .input-group {
      background: #000033;
      border: 2px solid #8888ff;
      padding: 12px;
      margin-bottom: 16px;
    }

    label {
      display: block;
      font-size: 14px;
      color: #ffff00;
      margin-bottom: 6px;
      margin-top: 10px;
    }

    label:first-child {
      margin-top: 0;
    }

    input[type="text"], select {
      width: 100%;
      background: #000;
      color: #fff;
      border: 2px solid #fff;
      padding: 8px;
      font-size: 14px;
      margin-bottom: 10px;
      outline: none;
    }

    .radio-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 12px;
      background: #000;
      border: 2px solid #fff;
      padding: 8px;
    }

    .radio-item {
      display: flex;
      align-items: center;
      cursor: pointer;
      font-size: 13px;
      line-height: 1.8;
      padding: 2px 4px;
      border-radius: 3px;
    }

    .radio-item:hover {
      background: #111144;
    }

    .radio-item input[type="radio"] {
      margin-right: 8px;
      accent-color: #ffcc00;
      cursor: pointer;
    }

    .example-box {
      font-size: 12px;
      color: #aaaaff;
      margin-bottom: 6px;
      padding-left: 4px;
      line-height: 1.8;
    }

    .flex-row {
      display: flex;
      gap: 8px;
    }

    .rpg-btn {
      width: 100%;
      background: #cc0000;
      color: #fff;
      border: 3px solid #fff;
      padding: 12px;
      font-size: 18px;
      cursor: pointer;
      text-shadow: 2px 2px #000;
      box-shadow: 3px 3px 0px #000;
      margin-top: 8px;
    }

    .rpg-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px #000;
    }

    .rpg-btn:disabled {
      opacity: 0.5;
      cursor: default;
    }

    .sub-btn {
      background: #333366;
      border: 2px solid #8888ff;
      color: #ccccff;
      font-size: 12px;
      padding: 6px 10px;
      cursor: pointer;
      margin-top: 12px;
    }

    .msg-box {
      background: #000;
      border: 3px solid #fff;
      padding: 12px;
      margin-top: 16px;
      display: none;
      line-height: 1.8;
      transition: border-color 0.2s ease;
    }

    .msg-title {
      color: #ffcc00;
      font-size: 16px;
      margin-bottom: 6px;
      border-bottom: 1px dashed #fff;
      padding-bottom: 4px;
      transition: color 0.2s ease;
    }

    .skill-name {
      color: #00ffcc;
      font-size: 15px;
      margin-bottom: 6px;
    }

    .history-box {
      background: #000022;
      border: 2px solid #5555ff;
      padding: 10px;
      margin-top: 16px;
    }

    .history-title {
      color: #aaaaff;
      font-size: 13px;
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .history-list {
      max-height: 160px;
      overflow-y: auto;
      font-size: 12px;
    }

    .history-entry {
      display: flex;
      justify-content: space-between;
      padding: 4px 2px;
      border-bottom: 1px dotted #333366;
      color: #ccccdd;
    }

    .history-pt {
      color: #00ffcc;
      flex-shrink: 0;
      margin-left: 8px;
    }

    .history-empty {
      color: #666699;
      font-size: 12px;
      text-align: center;
      padding: 8px 0;
    }

    .loading-note {
      text-align: center;
      font-size: 12px;
      color: #8888ff;
      margin-bottom: 8px;
    }

    .settings-box {
      margin-top: 16px;
    }
  </style>
</head>
<body>

<div class="rpg-window">
  <div class="title-banner">⚔️ <ruby>昨日<rt>きのう</rt></ruby>の<ruby>自分<rt>じぶん</rt></ruby>を<ruby>越<rt>こ</rt></ruby>えろ！</div>
  <div class="subtitle">〜 <ruby>長岡<rt>ながおか</rt></ruby>ヒーロー<ruby>育成<rt>いくせい</rt></ruby>RPG 〜</div>

  <!-- 最上部に配置した保護者設定バー -->
  <div class="parent-bar">
    <span id="lockStatus">🔓 プレイ<ruby>制限<rt>せいげん</rt></ruby>: <ruby>無制限<rt>むせいげん</rt></ruby></span>
    <button class="parent-btn" onclick="toggleParentControl()">🔒 <ruby>保護者<rt>ほごしゃ</rt></ruby><ruby>設定<rt>せってい</rt></ruby></button>
  </div>
  
  <div class="loading-note" id="loadingNote">セーブデータを<ruby>読<rt>よ</rt></ruby>み<ruby>込<rt>こ</rt></ruby>み<ruby>中<rt>ちゅう</rt></ruby>...</div>

  <!-- ステージ画面 -->
  <div class="stage" id="stage">
    <div class="levelup-banner" id="levelupBanner">★ レベルアップ！ ★</div>
    <div class="level-badge" id="heroTitle"></div>
    <canvas id="characterCanvas" width="288" height="144" style="max-width:100%; height:auto; border:2px solid #333366;"></canvas>

    <div class="xp-bar-wrap">
      <div class="xp-bar-fill" id="xpBarFill"></div>
    </div>
    <div class="xp-label" id="xpLabel">-</div>

    <div class="status-container">
      <div class="status-item">
        <div class="status-title"><ruby>今日<rt>きょう</rt></ruby>のパワー</div>
        <div class="status-num" id="todayPower">-</div>
      </div>
      <div class="status-item">
        <div class="status-title"><ruby>昨日<rt>きのう</rt></ruby>の<ruby>自分<rt>じぶん</rt></ruby></div>
        <div class="status-num" id="yesterdayPower">-</div>
      </div>
    </div>
  </div>

  <!-- 入力フォーム -->
  <div class="input-group">
    <label>▶ ヒーローの<ruby>名<rt>な</rt></ruby>まえ</label>
    <input type="text" id="heroName" value="ミライ" placeholder="※ほんみょうはいれないでね">

    <!-- ラジオボタン形式のカテゴリー選択欄 -->
    <label>▶ <ruby>取<rt>と</rt></ruby>り<ruby>組<rt>く</rt></ruby>んだカテゴリー</label>
    <div class="radio-group">
      <label class="radio-item">
        <input type="radio" name="actionCategory" value="宿題・勉強" data-label="宿題・勉強" checked>
        <span>【<ruby>学習<rt>がくしゅう</rt></ruby>】<ruby>宿題<rt>しゅくだい</rt></ruby>・<ruby>勉強<rt>べんきょう</rt></ruby>・<ruby>習<rt>なら</rt></ruby>い<ruby>事<rt>ごと</rt></ruby></span>
      </label>
      <label class="radio-item">
        <input type="radio" name="actionCategory" value="お手伝い" data-label="お手伝い">
        <span>【<ruby>貢献<rt>こうけん</rt></ruby>】お<ruby>手伝<rt>てつだ</rt></ruby>い・<ruby>掃除<rt>そうじ</rt></ruby></span>
      </label>
      <label class="radio-item">
        <input type="radio" name="actionCategory" value="運動・健康" data-label="運動・健康">
        <span>【<ruby>体力<rt>たいりょく</rt></ruby>】<ruby>運動<rt>うんどう</rt></ruby>・スポーツ・<ruby>早<rt>はや</rt></ruby><ruby>起<rt>お</rt></ruby>き</span>
      </label>
      <label class="radio-item">
        <input type="radio" name="actionCategory" value="読書" data-label="読書">
        <span>【<ruby>知識<rt>ちしき</rt></ruby>】<ruby>読書<rt>どくしょ</rt></ruby>（<ruby>本<rt>ほん</rt></ruby>・<ruby>図鑑<rt>ずかん</rt></ruby>）</span>
      </label>
      <label class="radio-item">
        <input type="radio" name="actionCategory" value="休養・自由時間" data-label="休養・自由時間">
        <span>【<ruby>休養<rt>きゅうよう</rt></ruby>】ゲーム・<ruby>漫画<rt>まんが</rt></ruby>・<ruby>昼寝<rt>ひるね</rt></ruby></span>
      </label>
    </div>

    <div class="flex-row">
      <div style="flex: 1;">
        <label>▶ <ruby>取<rt>と</rt></ruby>り<ruby>組<rt>く</rt></ruby>んだ<ruby>時間<rt>じかん</rt></ruby></label>
        <select id="actionTime">
          <!-- デフォルトを5分間に設定 -->
          <option value="5" selected>5分間</option>
          <option value="10">10分間</option>
          <option value="15">15分間</option>
          <option value="30">30分間</option>
          <option value="45">45分間</option>
          <option value="60">60分以上</option>
        </select>
      </div>
    </div>

    <!-- メモ記載例エリア -->
    <label>▶ <ruby>詳<rt>くわ</rt></ruby>しい<ruby>内容<rt>ないよう</rt></ruby>（メモ）</label>
    <div class="example-box">
      <ruby>例<rt>れい</rt></ruby>：<ruby>漢字<rt>かんじ</rt></ruby>ドリル／<ruby>皿洗<rt>さらあら</rt></ruby>い／<ruby>走<rt>はし</rt></ruby>り<ruby>込<rt>こ</rt></ruby>み
    </div>
    <input type="text" id="actionDetail" placeholder="なにをしたか入力してね">

    <button class="rpg-btn" id="powerUpBtn" onclick="executePowerUp()" disabled>⚔️ パワーアップ！</button>
  </div>

  <!-- メッセージ表示エリア -->
  <div class="msg-box" id="msgBox">
    <div class="msg-title" id="msgTitle">★ <ruby>判定<rt>はんてい</rt></ruby><ruby>結果<rt>けっか</rt></ruby></div>
    <div class="skill-name" id="skillName"></div>
    <div id="msgContent"></div>
  </div>

  <!-- 履歴 -->
  <div class="history-box">
    <div class="history-title">
      <span>📜 ぼうけんの<ruby>記録<rt>きろく</rt></ruby></span>
      <span id="historyCount"></span>
    </div>
    <div class="history-list" id="historyList">
      <div class="history-empty">まだ<ruby>記録<rt>きろく</rt></ruby>がありません</div>
    </div>
  </div>

  <!-- データリセットボタン -->
  <div class="settings-box">
    <button class="sub-btn" style="width: 100%;" onclick="resetHero()">🔄 このヒーローのデータをリセット</button>
  </div>

</div>

<script>
  const canvas = document.getElementById('characterCanvas');
  const ctx = canvas.getContext('2d');

  // 暗証番号（361）
  const PARENT_PIN = "361";

  let state = {
    power: 0,
    history: [],
    parentLock: false,        // false: 無制限, true: 各カテゴリ2回まで
    categoryCounts: {},       // 本日のカテゴリ別実行回数
    lastPlayDate: "",         // YYYY-MM-DD
    lastSkill: "",            // 連続防止用
    lastMsg: ""               // 連続防止用
  };

  let currentHeroKey = null;
  let currentLevel = 1;

  function getTodayStr() {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  }

  // ── ステージ背景 ─────────────
  const SCENE_NAMES = [
    "<ruby>村<rt>むら</rt></ruby>はずれ",
    "<ruby>町<rt>まち</rt></ruby>なか",
    "<ruby>森<rt>もり</rt></ruby>の<ruby>入口<rt>いりぐち</rt></ruby>",
    "<ruby>深<rt>ふか</rt></ruby>い<ruby>森<rt>もり</rt></ruby>",
    "<ruby>山道<rt>やまみち</rt></ruby>",
    "<ruby>洞窟<rt>どうくつ</rt></ruby>",
    "<ruby>城下町<rt>じょうかまち</rt></ruby>",
    "<ruby>王<rt>おう</rt></ruby>の<ruby>城<rt>しろ</rt></ruby>"
  ];
  const horizon = 100;

  function drawCloud(x, y) {
    ctx.beginPath();
    ctx.arc(x, y, 8, 0, Math.PI * 2);
    ctx.arc(x + 10, y - 4, 10, 0, Math.PI * 2);
    ctx.arc(x + 20, y, 8, 0, Math.PI * 2);
    ctx.fill();
  }

  function drawHouse(x, y, w, h, wallColor, roofColor) {
    ctx.fillStyle = wallColor;
    ctx.fillRect(x, y, w, h);
    ctx.fillStyle = roofColor;
    ctx.beginPath();
    ctx.moveTo(x - 4, y);
    ctx.lineTo(x + w / 2, y - 14);
    ctx.lineTo(x + w + 4, y);
    ctx.closePath();
    ctx.fill();
  }

  function drawTree(x, groundY, size) {
    ctx.fillStyle = "#5a3a22";
    ctx.fillRect(x + size * 0.4, groundY - size * 0.3, size * 0.2, size * 0.3);
    ctx.fillStyle = "#2e6b3e";
    ctx.beginPath();
    ctx.moveTo(x, groundY - size * 0.3);
    ctx.lineTo(x + size * 0.5, groundY - size * 1.1);
    ctx.lineTo(x + size, groundY - size * 0.3);
    ctx.closePath();
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(x + size * 0.12, groundY - size * 0.6);
    ctx.lineTo(x + size * 0.5, groundY - size * 1.4);
    ctx.lineTo(x + size * 0.88, groundY - size * 0.6);
    ctx.closePath();
    ctx.fill();
  }

  function drawStalactite(x, len) {
    ctx.fillStyle = "#45454f";
    ctx.beginPath();
    ctx.moveTo(x, 0);
    ctx.lineTo(x + 10, 0);
    ctx.lineTo(x + 5, len);
    ctx.closePath();
    ctx.fill();
  }

  function drawCrystal(x, y, color) {
    ctx.save();
    ctx.shadowColor = color;
    ctx.shadowBlur = 8;
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x, y - 10);
    ctx.lineTo(x + 6, y);
    ctx.lineTo(x, y + 10);
    ctx.lineTo(x - 6, y);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  function drawCastleTower(x, y, w, h, color) {
    ctx.fillStyle = color;
    ctx.fillRect(x, y, w, h);
    ctx.fillStyle = "#d4af37";
    ctx.fillRect(x - 2, y - 10, w + 4, 10);
    ctx.fillStyle = "#c0392b";
    ctx.beginPath();
    ctx.moveTo(x + w / 2, y - 24);
    ctx.lineTo(x + w / 2, y - 10);
    ctx.lineTo(x + w / 2 + 14, y - 16);
    ctx.closePath();
    ctx.fill();
  }

  function drawMountain(baseX, baseY, w, h, color) {
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(baseX, baseY);
    ctx.lineTo(baseX + w / 2, baseY - h);
    ctx.lineTo(baseX + w, baseY);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = "#ffffff";
    ctx.beginPath();
    ctx.moveTo(baseX + w / 2 - 8, baseY - h + 14);
    ctx.lineTo(baseX + w / 2, baseY - h);
    ctx.lineTo(baseX + w / 2 + 8, baseY - h + 14);
    ctx.closePath();
    ctx.fill();
  }

  function drawBackground(level) {
    const w = canvas.width, h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    if (level === 1) {
      const g = ctx.createLinearGradient(0, 0, 0, horizon);
      g.addColorStop(0, "#6ec6ff"); g.addColorStop(1, "#cdeeff");
      ctx.fillStyle = g; ctx.fillRect(0, 0, w, horizon);
      ctx.fillStyle = "#ffffff";
      drawCloud(40, 22); drawCloud(150, 16); drawCloud(230, 30);
      ctx.fillStyle = "#5cb85c";
      ctx.fillRect(0, horizon, w, h - horizon);
      drawHouse(232, horizon - 26, 26, 26, "#d98c4a", "#8b3a2f");
    } else if (level === 2) {
      const g = ctx.createLinearGradient(0, 0, 0, horizon);
      g.addColorStop(0, "#ffb870"); g.addColorStop(1, "#ffe1b0");
      ctx.fillStyle = g; ctx.fillRect(0, 0, w, horizon);
      ctx.fillStyle = "#b8ae9c";
      ctx.fillRect(0, horizon, w, h - horizon);
      ctx.fillStyle = "#8f8574";
      ctx.fillRect(0, horizon + 20, w, 6);
      const houseColors = [["#e0a458", "#8c4a2f"], ["#c9d6df", "#5c6b73"], ["#e3b7a0", "#7a4a3a"]];
      let hx = 6;
      for (let i = 0; i < 4; i++) {
        const [wall, roof] = houseColors[i % houseColors.length];
        drawHouse(hx, horizon - 24, 26, 26, wall, roof);
        hx += 72;
      }
    } else if (level === 3) {
      const g = ctx.createLinearGradient(0, 0, 0, horizon);
      g.addColorStop(0, "#8fd6a0"); g.addColorStop(1, "#c7ecc9");
      ctx.fillStyle = g; ctx.fillRect(0, 0, w, horizon);
      ctx.fillStyle = "#3f9a4e";
      ctx.fillRect(0, horizon, w, h - horizon);
      [20, 110, 200, 260].forEach((x, i) => drawTree(x, horizon - 4, 26));
    } else if (level === 4) {
      const g = ctx.createLinearGradient(0, 0, 0, horizon);
      g.addColorStop(0, "#1c3a30"); g.addColorStop(1, "#335c46");
      ctx.fillStyle = g; ctx.fillRect(0, 0, w, horizon);
      ctx.fillStyle = "#132a1c";
      ctx.fillRect(0, horizon, w, h - horizon);
      [4, 34, 64, 96, 128, 158, 190, 220, 250, 275].forEach((x, i) => drawTree(x, horizon - 2, i % 2 === 0 ? 36 : 28));
    } else if (level === 5) {
